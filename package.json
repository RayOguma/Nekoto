{
  "name": "nekoto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base=./",
    "typecheck": "tsc && tsc -p electron --noEmit",
    "test": "vitest run --passWithNoTests",
    "app": "npm run build && tsc -p electron && electron .",
    "dist": "npm run build && tsc -p electron && electron-builder --win",
    "release": "npm run dist && node scripts/publish.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.5",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wokoto": "file:../wokoto"
  },
  "description": "日本語の文を書き換えて進むゲーム",
  "author": "RayOguma",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "jp.rayoguma.nekoto",
    "productName": "ねこと",
    "artifactName": "nekoto-setup-${version}.${ext}",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ねこと"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "RayOguma",
        "repo": "Nekoto",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
